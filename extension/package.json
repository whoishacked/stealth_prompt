{
  "name": "stealth-prompt-extension",
  "version": "0.2.0",
  "private": true,
  "description": "Browser-native AI red-team assistant for authorized, targeted testing.",
  "type": "module",
  "scripts": {
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/tests/*.test.js\"",
    "build": "node build.mjs",
    "clean": "rm -rf dist dist-test"
  },
  "devDependencies": {
    "@types/chrome": "0.2.6",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
